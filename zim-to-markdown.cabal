cabal-version:      3.0
name:               zim-to-markdown
version:            0.2.0.0
synopsis:           Converts Zim wiki pages to Markdown and back.
description:        A command line converter between Zim wiki markup and Markdown for single pages and whole notebooks.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Tunai Raiol
maintainer:         Tunai Raiol
category:           Text
build-type:         Simple
extra-doc-files:    README.md
                    docs/architecture.md
                    docs/cli.md
                    docs/conversion.md
                    docs/domain.md
                    docs/versioning.md

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    exposed-modules:
        ZimToMarkdown.Converter
        ZimToMarkdown.Domain
        ZimToMarkdown.Inline
        ZimToMarkdown.Links
        ZimToMarkdown.Markdown
        ZimToMarkdown.Notebook
        ZimToMarkdown.Options
        ZimToMarkdown.Paths
        ZimToMarkdown.Version
        ZimToMarkdown.Zim
    hs-source-dirs:   src
    build-depends:
        base        >=4.18 && <5,
        containers  >=0.6  && <0.9,
        filepath    >=1.4  && <1.6,
        text        >=2.0  && <2.2
    default-language: GHC2021
    default-extensions: OverloadedStrings

executable zim-to-markdown
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base              >=4.18 && <5,
        bytestring        >=0.11 && <0.13,
        containers        >=0.6  && <0.9,
        directory         >=1.3  && <1.4,
        filepath          >=1.4  && <1.6,
        text              >=2.0  && <2.2,
        zim-to-markdown
    default-language: GHC2021
    default-extensions: OverloadedStrings
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite zim-to-markdown-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:
        base              >=4.18 && <5,
        containers        >=0.6  && <0.9,
        filepath          >=1.4  && <1.6,
        text              >=2.0  && <2.2,
        zim-to-markdown
    default-language: GHC2021
    default-extensions: OverloadedStrings
